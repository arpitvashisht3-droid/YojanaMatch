# ============================================================
# YojanaMatch Database – Environment Variables Example
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to '.env' in the same directory.
#   2. Fill in the actual values for your environment.
#   3. NEVER commit a real .env file with secrets to Git.
#   4. All variables below are read via 'dotenv' at runtime.
# ============================================================

# --------------------------------
# MongoDB Connection (REQUIRED)
# --------------------------------
# Local MongoDB (default for development):
MONGODB_URI=mongodb://localhost:27017

# MongoDB Atlas (for staging / production):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# The name of the MongoDB database to use.
# A separate DB per environment is strongly recommended.
MONGODB_DB_NAME=yojanamatch

# --------------------------------
# Application Settings
# --------------------------------
# Environment mode: development | staging | production
NODE_ENV=development
