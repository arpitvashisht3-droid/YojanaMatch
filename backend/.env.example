# Gemini API Key for natural language extraction & personalized explanations
# If omitted or un-set, Backend1 gracefully degrades to deterministic heuristic parsing & static summaries.
GEMINI_API_KEY=

# Open Government Data Platform India (data.gov.in) — required for live scheme catalogue
# Register at https://data.gov.in/ and create an API key.
DATA_GOV_IN_API_KEY=

# Full data.gov.in resource API URL (JSON). Example shape:
# https://api.data.gov.in/resource/<RESOURCE_ID>?format=json&limit=100
# The provider appends api-key automatically if missing from the URL.
SCHEME_DATA_SOURCE_URL=

PORT=8000
HOST=0.0.0.0
